---
interface Props {
	mode?: "auto" | "development" | "production";
}

const { mode = "auto" } = Astro.props;

// 解析最终模式：auto 时按构建环境自动判断（生产才真正发送数据）
const resolvedMode =
	mode === "auto" ? (import.meta.env.DEV ? "development" : "production") : mode;
// 与 @vercel/speed-insights v1 的 getScriptSrc() 保持一致：
// 生产加载站点内 /_vercel/speed-insights/script.js（由 Vercel 部署时自动注入），
// 开发加载官方 debug 脚本（仅控制台输出，不产生真实数据）
const scriptSrc =
	resolvedMode === "development"
		? "https://va.vercel-scripts.com/v1/speed-insights/script.debug.js"
		: "/_vercel/speed-insights/script.js";
---

<script is:inline data-swup-ignore-script define:vars={{ resolvedMode }}>
	window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
	window.sim = resolvedMode;
</script>
<script is:inline data-swup-ignore-script defer src={scriptSrc}></script>
