---
import type { MarkdownHeading } from "astro";
import "@/styles/toc.css";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { computeTocItems } from "@/utils/toc-shared";

interface Props {
	headings: MarkdownHeading[];
	encrypted?: boolean;
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const {
	headings = [],
	encrypted = false,
	class: className,
	style,
	widgetConfig,
} = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 加密文章不在服务端渲染目录（避免标题泄露），交由客户端解密后生成
const items = encrypted ? [] : computeTocItems(headings, { maxLevel: 3 });
---

<WidgetLayout
  name={i18n(I18nKey.tableOfContents)}
  showTitle={showTitle}
  id="sidebar-toc"
  class={className}
  style={style}
>
  <div
    class:list={[
      "toc-scroll-container",
      "custom-scrollbar",
      (encrypted || items.length > 0) && "toc-has-items",
    ]}
  >
    <div
      class="toc-content"
      id="sidebar-toc-content"
    >
      {!encrypted && items.length > 0 && (
        <>
          {items.map((item) => (
            <a
              href={item.href}
              class={`toc-item toc-level-${item.depthLevel}`}
              data-heading-id={item.headingId}
              aria-label={item.text}
              title={item.text}
            >
              <div class={`toc-badge ${item.badgeKind === "index" ? "toc-badge-index" : ""}`}>
                {item.badgeKind === "index" ? (
                  item.badgeIndex
                ) : item.badgeKind === "dot" ? (
                  <span class="toc-badge-dot"></span>
                ) : (
                  <span class="toc-badge-dot toc-badge-dot-sm"></span>
                )}
              </div>
              <div class={`toc-label ${item.labelPrimary ? "toc-label-primary" : "toc-label-secondary"}`}>
                {item.text}
              </div>
            </a>
          ))}
          <div id="sidebar-active-indicator" class="toc-active-indicator" style="opacity: 0;"></div>
        </>
      )}
      {!encrypted && items.length === 0 && (
        <div class="text-center py-8 text-gray-500 dark:text-gray-400">
          <p>{i18n(I18nKey.tocEmpty)}</p>
        </div>
      )}
      {/* 加密文章：留空，客户端解密后由 TOCManager 填充 */}
    </div>
  </div>
</WidgetLayout>

<style lang="stylus">
/* SidebarTOC 特定样式 */
.toc-scroll-container
	/* 目录较长时的上限：由脚本写入 --sidebar-toc-max-h，保证整张卡片完整落在视口内 */
	max-height: var(--sidebar-toc-max-h, calc(100vh - 25rem))
	/* 滚动条与内容之间的小间隙（从共享样式挪入，避免影响浮动目录的对称内边距） */
	padding-right: 0.125rem

/* 目录较少时给卡片一个最小高度，避免卡片过分局促（无目录时保持紧凑） */
.toc-scroll-container.toc-has-items
	min-height: var(--sidebar-toc-min-h, 12rem)
</style>

<script>
  import { TOCManager } from "@/utils/toc-utils";

  if (typeof window.SidebarTOC === "undefined") {
    window.SidebarTOC = {
      manager: null
    };
  }

  // 底部预留的上下限（px）：与「导航栏下边 → 内容区顶边」的高度一致，避免卡片贴底
  const TOC_RESERVE_MIN = 16;
  const TOC_RESERVE_MAX = 64;

  let heightRafId = 0;
  let stickyObserver: ResizeObserver | null = null;

  /**
   * 顶部留白 = 导航栏下边到内容区顶边的高度，作为卡片下方的预留值，保证上下留白一致。
   * 内容区顶边取 .content-panel 解析后的 top（即 --content-top，随壁纸模式/首页/断点变化）；
   * 导航栏下边取实际绘制的 #navbar 底边（fixed 定位，用视口坐标，与滚动位置无关）。
   * 静态导航栏、全屏壁纸等取不到有效值时退回下限。
   */
  function getTopInset(): number {
    const panel = document.getElementById("content-panel");
    const navbar = document.getElementById("navbar");
    if (!panel || !navbar) return TOC_RESERVE_MIN;

    const contentTop = Number.parseFloat(window.getComputedStyle(panel).top);
    // fixed 导航栏的视口坐标恒定；static 导航栏需换算到文档坐标（否则预留值会随滚动漂移）
    const navbarRect = navbar.getBoundingClientRect();
    const navbarBottom =
      window.getComputedStyle(navbar).position === "fixed"
        ? navbarRect.bottom
        : navbarRect.bottom + window.scrollY;
    if (!Number.isFinite(contentTop) || !Number.isFinite(navbarBottom)) {
      return TOC_RESERVE_MIN;
    }

    return Math.min(
      TOC_RESERVE_MAX,
      Math.max(TOC_RESERVE_MIN, Math.round(contentTop - navbarBottom)),
    );
  }

  /**
   * 计算目录滚动区的可用高度并写入 --sidebar-toc-max-h。
   * 目标：目录再长，整张卡片（标题 + 列表）也完整落在视口内，超出部分在卡片内部滚动。
   * 含多次布局读取，只在初始化 / resize / sticky 列尺寸变化时调用，不挂在滚动路径上。
   */
  function updateSidebarTOCHeight(): void {
    const wrapper = document.getElementById("sidebar-toc");
    const card = wrapper?.closest("widget-layout") as HTMLElement | null;
    const scroll = card?.querySelector<HTMLElement>(".toc-scroll-container");
    if (!card || !scroll) return;
    // 组件在当前页面被隐藏（showOnPostPage / hideOnNonPostPage）时不参与计算
    if (card.offsetParent === null) return;

    // sticky 列吸顶后的偏移（top-0 / top-4）
    const sticky = card.closest<HTMLElement>(".sticky");
    const stickyTop = sticky
      ? Number.parseFloat(window.getComputedStyle(sticky).top) || 0
      : 0;

    // 卡片中不参与滚动的部分（标题、内边距）
    const chrome = card.offsetHeight - scroll.offsetHeight;

    // sticky 列里位于目录下方的组件同样要完整可见，为它们预留高度
    let below = 0;
    if (sticky) {
      const gap = Number.parseFloat(window.getComputedStyle(sticky).rowGap) || 0;
      for (
        let sibling = card.nextElementSibling;
        sibling;
        sibling = sibling.nextElementSibling
      ) {
        if (sibling instanceof HTMLElement && sibling.offsetParent !== null) {
          below += sibling.offsetHeight + gap;
        }
      }
    }

    // 只给出可用上限：内容更短时卡片自然收缩，最小值交给 CSS 的 min-height
    // （按 CSS 高度算法，min-height 优先级高于 max-height）
    const available = Math.round(
      window.innerHeight - stickyTop - chrome - below - getTopInset(),
    );
    const next = `${Math.max(0, available)}px`;

    // 值未变化就不写，避免 ResizeObserver 自触发形成循环
    if (scroll.style.getPropertyValue("--sidebar-toc-max-h") !== next) {
      scroll.style.setProperty("--sidebar-toc-max-h", next);
    }
  }

  // rAF 合帧，避免 resize / ResizeObserver 连续触发时重复布局读取
  function scheduleSidebarTOCHeight(): void {
    if (heightRafId) return;
    heightRafId = window.requestAnimationFrame(() => {
      heightRafId = 0;
      updateSidebarTOCHeight();
    });
  }

  // 侧栏目录在 #right-sidebar-static 内，不是 swup 容器：站内导航后其 DOM 不被替换。
  // attach() 内部会校验现有锚点是否属于当前正文——新鲜则直接附着（首屏 SSR），
  // 过时或缺失（导航后/加密解密后）则自动回退 DOM 遍历重建，无需在此区分场景。
  function initSidebarTOC() {
    const tocContent = document.getElementById("sidebar-toc-content");
    if (!tocContent) return;

    // 目录卡片高度随视口/兄弟组件变化，切入页面时同步一次
    scheduleSidebarTOCHeight();

    try {
      // 清理旧实例
      if (window.SidebarTOC.manager) {
        window.SidebarTOC.manager.cleanup();
      }

      // 创建新实例
      window.SidebarTOC.manager = new TOCManager({
        contentId: "sidebar-toc-content",
        indicatorId: "sidebar-active-indicator",
        maxLevel: 3,
        scrollOffset: 80,
      });

      window.SidebarTOC.manager.attach();
    } catch (error) {
      console.error("Failed to load TOCManager for SidebarTOC:", error);
    }
  }

  // 防止 Swup 切页重跑脚本时重复注册监听器（initSidebarTOC 由下方一次性监听器在切页时触发）
  if (!window.__sidebarTOCInit) {
    window.__sidebarTOCInit = true;

    // 初始化
    // 确保 DOM 准备好后再执行
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSidebarTOC);
    } else {
      initSidebarTOC();
    }

    // 页面切换时重新初始化
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(initSidebarTOC, 100);
    });

    // Astro 页面切换事件
    document.addEventListener("astro:page-load", () => {
      setTimeout(initSidebarTOC, 100);
    });

    // 浏览器导航事件
    window.addEventListener("popstate", () => {
      setTimeout(initSidebarTOC, 200);
    });

    // 监听 hashchange（但排除 TOC 内部导航）
    window.addEventListener("hashchange", () => {
      if (!window.tocInternalNavigation) {
        setTimeout(initSidebarTOC, 100);
      }
      window.tocInternalNavigation = false;
    });

    // 密码解密后重新初始化 TOC（需 DOM 遍历重建）
    document.addEventListener("password:decrypted", () => {
      setTimeout(initSidebarTOC, 200);
    });

    // 视口尺寸变化会改变目录卡片的可用高度
    window.addEventListener("resize", scheduleSidebarTOCHeight);

    // sticky 列内其它组件展开/收起同样会改变可用高度，跟随其尺寸变化
    if (!stickyObserver && typeof ResizeObserver !== "undefined") {
      const stickyHost = document
        .getElementById("sidebar-toc")
        ?.closest(".sticky");
      if (stickyHost) {
        stickyObserver = new ResizeObserver(scheduleSidebarTOCHeight);
        stickyObserver.observe(stickyHost);
      }
    }
  }
</script>
