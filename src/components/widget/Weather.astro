---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	city?: string;
	adcode?: string;
	extended?: boolean;
}

const {
	class: className,
	style,
	widgetConfig,
	city,
	adcode,
	extended = true,
} = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const collapsedHeight = "9rem";
const CACHE_KEY = "weather_data_cache";
const CACHE_DURATION = 30 * 60 * 1000;
---

<WidgetLayout
	name="天气预报"
	showTitle={showTitle}
	id="weather-widget"
	isCollapsed={true}
	collapsedHeight={collapsedHeight}
	class={className}
	style={style}
>
	<div class="weather-container" data-weather-init>
		<div class="weather-loading" data-weather-loading>
			<div class="loading-spinner"></div>
			<span>加载中...</span>
		</div>

		<div class="weather-error weather-hidden" data-weather-error>
			<Icon name="material-symbols:error-outline" class="error-icon" />
			<span data-error-message>加载失败</span>
			<button class="retry-btn" data-retry-btn type="button">
				<Icon name="material-symbols:refresh" />
				<span>重试</span>
			</button>
		</div>

		<div class="weather-content weather-hidden" data-weather-content>
			<div class="weather-header">
				<div class="location-info">
					<Icon name="material-symbols:location-on" class="location-icon" />
					<strong data-city></strong>
					<span class="district" data-district></span>
				</div>
				<Icon name="material-symbols:wb-sunny" class="weather-icon" data-weather-icon />
			</div>

			<div class="temperature-section">
				<span class="temperature" data-temperature>--</span>
				<span class="temperature-unit">°</span>
				<span class="weather-desc" data-weather>--</span>
			</div>

			<div class="temperature-range">
				<span class="temp-max">高温 <span data-temp-max>--</span>°C</span>
				<span>/</span>
				<span class="temp-min">低温 <span data-temp-min>--</span>°C</span>
			</div>

			{extended && (
				<div class="weather-extended" data-weather-extended>
					<div class="extended-item">
						<Icon name="material-symbols:air" class="extended-icon icon-wind" />
						<span><small>风力</small><b data-wind>--</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:visibility" class="extended-icon icon-visibility" />
						<span><small>能见度</small><b data-visibility>--km</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:thermostat" class="extended-icon icon-feels-like" />
						<span><small>体感温度</small><b data-feels-like>--°C</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:humidity-high" class="extended-icon icon-humidity" />
						<span><small>湿度</small><b data-humidity>--%</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:compress" class="extended-icon icon-pressure" />
						<span><small>气压</small><b data-pressure>--hPa</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:eco" class="extended-icon icon-aqi" />
						<span><small>空气质量</small><b><span data-aqi>--</span> <em data-aqi-category>--</em></b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:cloud" class="extended-icon icon-cloud" />
						<span><small>云量</small><b data-cloud>--%</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:sunny" class="extended-icon icon-uv" />
						<span><small>紫外线</small><b data-uv>--</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:rainy" class="extended-icon icon-precipitation" />
						<span><small>降水量</small><b data-precipitation>--mm</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:water-drop" class="extended-icon icon-pop" />
						<span><small>降水概率</small><b data-pop>--%</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:wb-sunny" class="extended-icon icon-sunrise" />
						<span><small>日出</small><b data-sunrise>--:--</b></span>
					</div>
					<div class="extended-item">
						<Icon name="material-symbols:sunny" class="extended-icon icon-sunset" />
						<span><small>日落</small><b data-sunset>--:--</b></span>
					</div>
					<div class="extended-item pollutants-item">
						<Icon name="material-symbols:science" class="extended-icon icon-pollutants" />
						<span class="pollutants"><small>污染物浓度</small><b>
							PM2.5 <span data-pm25>--</span> · PM10 <span data-pm10>--</span> · O₃ <span data-o3>--</span> · NO₂ <span data-no2>--</span> · SO₂ <span data-so2>--</span> · CO <span data-co>--</span>
						</b></span>
					</div>
				</div>
			)}

			<div class="update-time">
				<Icon name="material-symbols:schedule" />
				<span data-report-time></span>
			</div>
		</div>
	</div>
</WidgetLayout>

<style>
	.weather-container {
		width: 100%;
	}

	.weather-hidden {
		display: none !important;
	}

	.weather-loading,
	.weather-error {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 1.5rem;
		text-align: center;
		color: var(--primary);
	}

	.loading-spinner {
		width: 2rem;
		height: 2rem;
		border: 2px solid color-mix(in srgb, var(--primary) 30%, transparent);
		border-top-color: var(--primary);
		border-radius: 50%;
		animation: weather-spin 0.8s linear infinite;
	}

	@keyframes weather-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.error-icon {
		font-size: 2rem;
		color: #ef4444;
	}

	.retry-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--primary);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--primary);
		cursor: pointer;
	}

	.retry-btn:hover {
		background: var(--primary);
		color: white;
	}

	.weather-content {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		animation: weather-fade-in 0.35s ease;
	}

	@keyframes weather-fade-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.weather-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.location-info {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.25rem;
	}

	.location-icon,
	.extended-icon {
		color: var(--primary);
	}

	.location-icon {
		font-size: 1rem;
	}

	.district {
		color: var(--primary);
		font-size: 0.8rem;
	}

	.weather-icon {
		flex-shrink: 0;
		color: var(--primary);
		font-size: 2.75rem;
		animation: weather-float 3s ease-in-out infinite;
	}

	@keyframes weather-float {
		50% {
			transform: translateY(-3px);
		}
	}

	.temperature-section {
		display: flex;
		align-items: baseline;
		gap: 0.2rem;
	}

	.temperature {
		font-size: 2.5rem;
		font-weight: 700;
		line-height: 1;
	}

	.temperature-unit {
		color: #999;
		font-size: 1rem;
	}

	.weather-desc {
		margin-left: 0.4rem;
		font-size: 1.25rem;
	}

	.temperature-range {
		display: flex;
		justify-content: center;
		gap: 0.45rem;
		font-size: 0.8rem;
	}

	.temp-max {
		color: #ef4444;
	}

	.temp-min {
		color: #3b82f6;
	}

	.weather-extended {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.35rem;
		padding-top: 0.8rem;
		border-top: 1px dashed var(--primary);
	}

	.extended-item {
		display: flex;
		align-items: center;
		min-width: 0;
		gap: 0.4rem;
		padding: 0.35rem 0.2rem;
	}

	.extended-icon {
		flex: 0 0 auto;
		font-size: 1.15rem;
	}

	.extended-item > span {
		display: flex;
		min-width: 0;
		flex-direction: column;
	}

	.extended-item small {
		color: var(--primary);
		font-size: 0.6rem;
	}

	.extended-item b {
		overflow: hidden;
		font-size: 0.78rem;
		font-weight: 500;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.extended-item em {
		padding: 0.05rem 0.25rem;
		border-radius: 0.2rem;
		background: #22c55e;
		color: white;
		font-size: 0.6rem;
		font-style: normal;
	}

	.icon-feels-like {
		color: #f97316;
	}

	.icon-visibility {
		color: #3b82f6;
	}

	.icon-pressure {
		color: #8b5cf6;
	}

	.icon-uv {
		color: #eab308;
	}

	.icon-precipitation,
	.icon-pop {
		color: #0ea5e9;
	}

	.icon-cloud {
		color: #64748b;
	}

	.icon-aqi {
		color: #22c55e;
	}

	.icon-pollutants {
		color: #ef4444;
	}

	.icon-sunrise {
		color: #fbbf24;
	}

	.icon-sunset {
		color: #fb923c;
	}

	.pollutants-item {
		grid-column: 1 / -1;
	}

	.pollutants b {
		white-space: normal;
	}

	.update-time {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		color: var(--primary);
		font-size: 0.7rem;
	}

	@media (max-width: 380px) {
		.weather-icon {
			font-size: 2.4rem;
		}

		.temperature {
			font-size: 2rem;
		}
	}

	@media (min-width: 768px) {
		:global(#weather-widget.collapsed) {
			height: 10rem;
		}
	}
</style>

<script is:inline define:vars={{ city, adcode, extended, CACHE_KEY, CACHE_DURATION }}>
	(() => {
		const apiUrl = "https://uapis.cn/api/v1/misc/weather?";
		const containers = document.querySelectorAll("[data-weather-init]");
		const weatherIcons = {
			100: "material-symbols:wb-sunny",
			101: "material-symbols:cloudy",
			102: "material-symbols:cloudy",
			103: "material-symbols:partly-cloudy-day",
			104: "material-symbols:cloudy",
			200: "material-symbols:air",
			201: "material-symbols:water-drop",
			202: "material-symbols:thunderstorm",
			203: "material-symbols:rainy",
			204: "material-symbols:ac-unit",
			205: "material-symbols:rainy",
			206: "material-symbols:thunderstorm",
			207: "material-symbols:snowing",
			208: "material-symbols:rainy",
			209: "material-symbols:rainy",
			210: "material-symbols:thunderstorm",
		};

		const setText = (container, selector, value) => {
			const element = container.querySelector(selector);
			if (element) element.textContent = value ?? "--";
		};

		const updateWeather = (container, data) => {
			setText(container, "[data-city]", data.city);
			setText(container, "[data-district]", data.district);
			setText(container, "[data-temperature]", data.temperature);
			setText(container, "[data-weather]", data.weather);
			setText(container, "[data-wind]", `${data.wind_direction || "--"} ${data.wind_power || ""}`.trim());
			setText(container, "[data-visibility]", data.visibility == null ? "--km" : `${data.visibility}km`);
			setText(container, "[data-feels-like]", data.feels_like == null ? "--°C" : `${data.feels_like}°C`);
			setText(container, "[data-humidity]", data.humidity == null ? "--%" : `${data.humidity}%`);
			setText(container, "[data-pressure]", data.pressure == null ? "--hPa" : `${data.pressure}hPa`);
			setText(container, "[data-cloud]", data.cloud == null ? "--%" : `${data.cloud}%`);
			setText(container, "[data-uv]", data.uv);
			setText(container, "[data-precipitation]", data.precipitation == null ? "--mm" : `${data.precipitation}mm`);
			setText(container, "[data-temp-max]", data.temp_max);
			setText(container, "[data-temp-min]", data.temp_min);
			setText(container, "[data-report-time]", data.report_time);

			const today = data.forecast?.[0];
			setText(container, "[data-pop]", today?.pop == null ? "--%" : `${today.pop}%`);
			setText(container, "[data-sunrise]", today?.sunrise);
			setText(container, "[data-sunset]", today?.sunset);

			const aqi = container.querySelector("[data-aqi]");
			const aqiCategory = container.querySelector("[data-aqi-category]");
			if (aqi) aqi.textContent = data.aqi == null ? "--" : String(data.aqi);
			if (aqiCategory) {
				aqiCategory.textContent = data.aqi_category || "--";
				aqiCategory.style.background =
					data.aqi_level >= 3 ? "#ef4444" : data.aqi_level === 2 ? "#eab308" : "#22c55e";
			}

			const pollutants = data.air_pollutants || {};
			setText(container, "[data-pm25]", pollutants.pm25);
			setText(container, "[data-pm10]", pollutants.pm10);
			setText(container, "[data-o3]", pollutants.o3);
			setText(container, "[data-no2]", pollutants.no2);
			setText(container, "[data-so2]", pollutants.so2);
			setText(container, "[data-co]", pollutants.co);

			const icon = container.querySelector("[data-weather-icon]");
			if (icon && weatherIcons[data.weather_icon]) {
				icon.setAttribute("name", weatherIcons[data.weather_icon]);
			}

			container.querySelector("[data-weather-loading]")?.classList.add("weather-hidden");
			container.querySelector("[data-weather-error]")?.classList.add("weather-hidden");
			container.querySelector("[data-weather-content]")?.classList.remove("weather-hidden");
		};

		const getCacheKey = () => {
			if (adcode) return `adcode_${adcode}`;
			if (city) return `city_${city}`;
			return "ip_location";
		};

		const readCache = () => {
			try {
				const raw = localStorage.getItem(CACHE_KEY + getCacheKey());
				if (!raw) return null;
				const cached = JSON.parse(raw);
				if (!cached?.timestamp || Date.now() - cached.timestamp > CACHE_DURATION) {
					return null;
				}
				return cached.data ?? null;
			} catch {
				return null;
			}
		};

		const writeCache = (data) => {
			try {
				localStorage.setItem(
					CACHE_KEY + getCacheKey(),
					JSON.stringify({ data, timestamp: Date.now() }),
				);
			} catch {
				//
			}
		};

		const loadWeather = async (container) => {
			const loading = container.querySelector("[data-weather-loading]");
			const error = container.querySelector("[data-weather-error]");
			const content = container.querySelector("[data-weather-content]");

			const cached = readCache();
			if (cached) {
				updateWeather(container, cached);
				return;
			}

			loading?.classList.remove("weather-hidden");
			error?.classList.add("weather-hidden");
			content?.classList.add("weather-hidden");

			try {
				const params = new URLSearchParams();
				if (adcode) params.set("adcode", adcode);
				else if (city) params.set("city", city);
				if (extended) params.set("extended", "true");
				params.set("forecast", "true");

				const response = await fetch(apiUrl + params.toString());
				if (!response.ok) throw new Error(`请求失败: ${response.status}`);
				const data = await response.json();
				writeCache(data);
				updateWeather(container, data);
			} catch (requestError) {
				loading?.classList.add("weather-hidden");
				error?.classList.remove("weather-hidden");
				const message = requestError instanceof Error ? requestError.message : "获取天气信息失败";
				setText(container, "[data-error-message]", message);
			}
		};

		containers.forEach((container) => {
			const retry = container.querySelector("[data-retry-btn]");
			retry?.addEventListener("click", () => loadWeather(container));
			loadWeather(container);
		});
	})();
</script>
